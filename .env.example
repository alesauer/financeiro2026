 # Exemplo de variáveis de ambiente para desenvolvimento
 # NÃO COMMITAR suas credenciais reais no repositório

 # URI de conexão com o banco de dados SQLAlchemy
 # - Para MySQL usando PyMySQL (recomendado no Windows):
 #   DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/gestao_financeira
 # - Para MySQL usando mysqlclient (nativo):
 #   DATABASE_URL=mysql://usuario:senha@localhost:3306/gestao_financeira
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/gestao_financeira

 # Chave secreta do Flask (troque por uma string forte em produção)
SECRET_KEY=troque_por_uma_chave_segura

 # Ambiente Flask (development/production)
FLASK_ENV=development

# JWT (opcional: se não definido, usa SECRET_KEY)
JWT_SECRET_KEY=

# Mailgun - envio de e-mails
# - Use seu domínio verificado (ex.: mg.seudominio.com)
# - Para região EU, mude a base URL
MAILGUN_API_KEY=330672c490f4d58ce72c5eae64987a89-42b8ce75-741097d8
MAILGUN_DOMAIN=mg.seudominio.com
 MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM=postmaster@sauer.pro.br

# Teste de envio (script)
# EMAIL_TEST_TO=destinatario@exemplo.com
# EMAIL_TEST_SUBJECT=Teste Mailgun
# EMAIL_TEST_TEXT=Envio de teste
