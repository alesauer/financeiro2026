FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN grep -vi '^mysqlclient' requirements.txt > requirements.docker.txt \
    && pip install --no-cache-dir --default-timeout=120 -r requirements.docker.txt

COPY . .

RUN mkdir -p /data \
    && sed -i 's/\r$//' /app/docker_entrypoint.sh \
    && chmod +x /app/docker_entrypoint.sh

EXPOSE 5000

CMD ["/app/docker_entrypoint.sh"]
